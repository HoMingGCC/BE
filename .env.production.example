# EC2에서 이 파일을 복사해 .env.production 으로 만들고 실제 값을 채우세요.
# docker run --env-file .env.production ... 형태로 사용합니다. (커밋 금지)

# RDS 엔드포인트 예: jdbc:mysql://homing-db.xxxxxxxx.ap-northeast-2.rds.amazonaws.com:3306/gcc?serverTimezone=Asia/Seoul
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 공공데이터포털 - 국세청_사업자등록정보 진위확인 및 상태조회 서비스
NTS_SERVICE_KEY=

# 카카오 디벨로퍼스 REST API 키 (아직 없으면 비워둬도 기동됨)
KAKAO_REST_KEY=
